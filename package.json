{
    "name":  "sutra-ide",
    "version":  "1.0.0",
    "description":  "SUTRA IDE - AI-Native Autonomous Product Development Studio",
    "main":  "desktop/main.cjs",
    "type":  "module",
    "scripts":  {
                    "dev":  "concurrently \"npm run omniroute\" \"npm run server\" \"npm run client\"",
                    "server":  "tsx watch server/index.ts",
                    "client":  "vite",
                    "omniroute":  "npm --prefix vendor/omniroute run dev",
                    "start:stack":  "concurrently \"npm run omniroute\" \"npm run start\"",
                    "build":  "vite build",
                    "build:server":  "tsc -p tsconfig.server.json",
                    "build:exe":  "npm run build \u0026\u0026 node scripts/package-exe.js",
                    "start":  "tsx server/index.ts",
                    "test":  "vitest",
                    "test:ui":  "vitest --ui",
                    "test:coverage":  "vitest --coverage",
                    "lint":  "eslint . --ext .ts,.tsx,.js,.jsx",
                    "lint:fix":  "eslint . --ext .ts,.tsx,.js,.jsx --fix",
                    "format":  "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"server/**/*.{ts,js,json}\"",
                    "format:check":  "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"server/**/*.{ts,js,json}\"",
                    "typecheck":  "tsc --noEmit",
                    "desktop":  "electron desktop/main.cjs",
                    "desktop:build":  "npm run build \u0026\u0026 electron-builder --win nsis --config electron-builder.json"
                },
    "dependencies":  {
                         "@monaco-editor/react":  "^4.7.0",
                         "@xterm/addon-canvas":  "^0.7.0",
                         "@xterm/addon-fit":  "^0.10.0",
                         "@xterm/addon-web-links":  "^0.11.0",
                         "@xterm/xterm":  "^5.5.0",
                         "better-sqlite3":  "^13.0.3",
                         "canvas-confetti":  "^1.9.4",
                         "chokidar":  "^4.0.3",
                         "cors":  "^2.8.5",
                         "diff":  "^9.0.0",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "localtunnel":  "^2.0.2",
                         "lucide-react":  "^1.16.0",
                         "monaco-editor":  "^0.52.2",
                         "node-pty":  "^1.1.0",
                         "qrcode":  "^1.5.4",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "tsx":  "^4.19.3",
                         "typescript-language-server":  "^6.0.0",
                         "uuid":  "^14.0.1",
                         "ws":  "^8.18.0",
                         "zustand":  "^5.0.3"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.39.5",
                            "@testing-library/jest-dom":  "^7.0.1",
                            "@testing-library/react":  "^16.3.2",
                            "@types/better-sqlite3":  "^9.6.0",
                            "@types/canvas-confetti":  "^1.9.0",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^5.0.0",
                            "@types/node":  "^22.13.4",
                            "@types/qrcode":  "^1.5.5",
                            "@types/react":  "^18.3.18",
                            "@types/react-dom":  "^18.3.5",
                            "@types/uuid":  "^10.0.0",
                            "@types/ws":  "^8.5.14",
                            "@typescript-eslint/eslint-plugin":  "^8.67.0",
                            "@typescript-eslint/parser":  "^8.67.0",
                            "@vitejs/plugin-react":  "^4.3.4",
                            "@vitest/ui":  "^4.1.11",
                            "autoprefixer":  "^10.4.20",
                            "concurrently":  "^9.1.2",
                            "electron":  "^44.0.0",
                            "electron-builder":  "^26.15.3",
                            "eslint":  "^9.39.5",
                            "eslint-config-prettier":  "^10.1.8",
                            "eslint-plugin-react":  "^7.37.5",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "globals":  "^17.11.0",
                            "jsdom":  "^29.1.1",
                            "postcss":  "^8.5.2",
                            "prettier":  "^3.9.6",
                            "tailwindcss":  "^3.4.17",
                            "typescript":  "^5.7.3",
                            "vite":  "^6.1.0",
                            "vitest":  "^4.1.11"
                        }
}
